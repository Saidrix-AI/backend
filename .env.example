# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/saidrix-tutor

# Auth — access token (JWT). Secret must be >= 32 chars.
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (days). Stored hashed server-side, rotated on use.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# CORS: comma-separated browser origins allowed to send credentials (cookies).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# COOKIE_DOMAIN=

# Trusted proxy hops in front of the app. 0 = none (local/no-proxy). In prod set
# to your real hop count (e.g. 1 behind one Nginx/Cloudflare) so per-IP rate
# limiting can't be bypassed via a spoofed X-Forwarded-For header.
TRUST_PROXY=0

# Email (optional). Leave SMTP_* blank in dev to log OTPs/links to the console.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Saidrix AI Tutor <no-reply@saidrix.com>

# LiveKit (voice sessions). REQUIRED — there is no default, because a default
# would silently be the public `livekit-server --dev` pair. For local work run
# `livekit-server --dev` and use devkey/secret; in production use real keys, or
# the server refuses to boot.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# How many students may be in a live class at once. Set by the CARTESIA plan's
# concurrency, not by LiveKit: past it Cartesia rejects the synthesis and the
# tutor joins the room and says nothing. Over the limit this answers 429 and the
# classroom falls back to reading mode. 0 disables the check.
VOICE_MAX_CONCURRENT_SESSIONS=15

# The secret the voice agent signs its own service tokens with. MUST be
# different from JWT_ACCESS_SECRET: the agent mints tokens on behalf of any
# student, so sharing the login secret would make a compromised voice host into
# account takeover for every user. Tokens signed with this carry iss=voice-agent
# and are accepted only on the routes the agent actually needs.
VOICE_SERVICE_SECRET=change-me-to-a-different-32-char-random-string

# LLM provider: anthropic | openai | google | openrouter
LLM_PROVIDER=openrouter
# Model. Must be able to make function/tool calls — every agent here forces
# one — and multimodal if you want the lecture svg vision critic. What the app
# runs on is openai/gpt-5.6-luna. For the streaming "thinking log" to show real
# reasoning you need a reasoning model (openai/gpt-oss-20b:free is free on
# OpenRouter and emits both reasoning + answer, but cannot do tool calls, so it
# only works for chat); non-reasoning models still stream the answer.
LLM_MODEL=openai/gpt-5.6-luna
# Optional. Leave blank: agents/llm.ts derives the value from the model name.
# It exists because gpt-5.x refuses function tools on /v1/chat/completions
# unless reasoning_effort is "none", and every agent here forces a tool call —
# set this only if a future model needs a value the derivation gets wrong.
# One of: none | low | medium | high | xhigh
LLM_REASONING_EFFORT=
# Optional: stronger model for the Course-maker agent's structured generation
# (falls back to LLM_MODEL). e.g. openai/gpt-4o-mini
COURSE_MAKER_MODEL=
# Optional: model for the project reviewer and the project-requirements author
# (falls back to LLM_MODEL). Code review benefits from a stronger model.
# e.g. openai/gpt-4o-mini
PROJECT_REVIEW_MODEL=

# Provider throttle (agents/shared/llmGate.ts). 0 = unlimited, which is only
# right if your provider has headroom: a single lecture fans out to ~70 calls,
# and past the cap every one 429s and the whole job is discarded. Set
# LLM_REQUESTS_PER_MINUTE to the provider's ACTUAL per-minute allowance — many
# gateways count failed attempts against the quota, so a 429 costs as much as a
# success. This project runs at 5. Keep concurrency well under it; more parallel
# requests only make the bursts worse, they do not make the job finish sooner.
LLM_MAX_CONCURRENCY=2
LLM_REQUESTS_PER_MINUTE=5
# Optional last resort for generation agents when LLM_MODEL keeps failing with
# transient errors. Only worth setting if it is on DIFFERENT capacity than
# LLM_MODEL (e.g. a paid model behind a failing free tier) — the same model here
# just re-fails and spends a slot out of the budget above.
LLM_FALLBACK_MODEL=

# --- Remote code runner (Judge0) ---
# The classroom runs Python and JavaScript in the student's browser for free.
# This covers everything else — C, C++, Java, Go, Rust, Ruby, PHP, Kotlin and
# ~20 more. Leave JUDGE0_URL blank and the remote lane is simply off: the
# workspace keeps working for Python/JS and the tutor is told not to offer the
# rest. Never put this key in the frontend; the browser calls /api/run instead.
#   hosted:      https://judge0-ce.p.rapidapi.com  (+ key and host below)
#   self-hosted: http://your-judge0:2358           (usually no key at all)
JUDGE0_URL=
JUDGE0_API_KEY=
# RapidAPI only — the host header it expects, e.g. judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=
# Seconds of CPU per submission. A teaching demo finishes in well under one.
JUDGE0_CPU_LIMIT_S=5
# Wall clock, which also has to cover a cold C++ or Java compile.
JUDGE0_WALL_LIMIT_S=15
JUDGE0_MEMORY_LIMIT_KB=128000
JUDGE0_TIMEOUT_MS=30000

# Provider API keys (only the one matching LLM_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Tools
# Web search (Tavily). Without this key the web_search tool is disabled and
# the agent simply answers without searching. Get a key at https://tavily.com
TAVILY_API_KEY=

# --- Freshness (live web search folded into generation) ----------------------
# With a Tavily key, the course-maker and lecture-maker each run a web search
# before writing and are instructed to teach the current versions, tooling and
# practices it returns rather than their training data. Costs one search per
# course outline, one per chapter and one per lecture. Set false to keep the
# chat agent's web_search tool but generate from training data alone.
AGENT_FRESHNESS_ENABLED=true
# Results injected per search. Higher crowds out the curriculum grounding.
AGENT_FRESHNESS_MAX_RESULTS=5
# Minutes an identical search query is reused, so a course's chapter searches
# are not billed repeatedly for the same question. 0 disables the cache.
AGENT_FRESHNESS_CACHE_MINUTES=60

# --- RAG knowledge base (Course-Content curriculum) ---
# All optional. Leave PINECONE_API_KEY blank to disable RAG entirely — the
# search_course_content tool is not registered and course/lecture generation
# runs exactly as before. To enable, set at least PINECONE_API_KEY,
# EMBEDDING_MODEL and EMBEDDING_DIMENSIONS, then run: npm run ingest:knowledge
PINECONE_API_KEY=
PINECONE_INDEX=saidrix-knowledge
PINECONE_NAMESPACE=course-content
# Serverless index location — used only when the index is first created.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings via any OpenAI-compatible endpoint. Defaults to OpenRouter's
# base + your OPENROUTER_API_KEY. NOTE: OpenRouter may not serve /embeddings for
# a given model — if a run fails with "returned 0 vectors", point
# EMBEDDING_BASE_URL at an OpenAI-compatible embeddings provider (OpenAI, Voyage,
# Jina, Together, …) and set EMBEDDING_API_KEY for it. No code change needed.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# Falls back to OPENROUTER_API_KEY when blank.
EMBEDDING_API_KEY=
# Required for RAG. e.g. openai/text-embedding-3-small (on an endpoint that serves it).
EMBEDDING_MODEL=
# Required for RAG — must match the model's output dimension (e.g. 1536).
EMBEDDING_DIMENSIONS=
# How many curriculum chunks the chat tool retrieves per query.
RAG_TOP_K=6

# --- Diagram inspection (lecture SVG blocks) --------------------------------
# Every generated diagram is rendered in headless Chromium so its geometry is
# measured rather than guessed, and the rendered image is reviewed by a vision
# model. Install the browser once:
#   npx playwright-core install chromium
# Set this first if you want it somewhere other than the default location
# (it is a few hundred MB). The same value must be set for the running server.
PLAYWRIGHT_BROWSERS_PATH=
# false = skip rendering entirely; geometry falls back to font metrics and the
# vision pass is skipped. Lectures still generate. Use this if you cannot
# install Chromium on the host.
LECTURE_SVG_RENDER_ENABLED=true
# false = measure in the browser but skip the vision review (saves ~1 image
# call per diagram).
LECTURE_SVG_VISION_ENABLED=true
# Defaults to the resolved LECTURE_SVG_MODEL, which is already vision-capable.
LECTURE_SVG_VISION_MODEL=
# Attempts per diagram: first draw plus repair rounds.
LECTURE_SVG_REPAIR_ROUNDS=3

# --- Lecture "Resources" section ---------------------------------------------
# Every lecture ends with free, topic-specific links (official docs, good free
# writing, and at most one YouTube video). The links come from two live Tavily
# searches and a model only ever picks among them by number, so it can never
# invent a URL — which is why this needs TAVILY_API_KEY and is off without one.
# Costs two searches plus one cheap call per lecture. Set false to end lectures
# at the quiz, as they did before.
LECTURE_RESOURCES_ENABLED=true
# Ranking a supplied list is easy work; defaults to LLM_MODEL.
LECTURE_RESOURCES_MODEL=

# --- Billing (Lemon Squeezy) --------------------------------------------------
# Lemon Squeezy is the merchant of record: it owns the card, the tax and the
# invoice, so no payment detail ever reaches this server.
#
# WITHOUT the first three keys billing is OFF: the paywall opens, checkout 503s,
# and quotas stop being enforced. That is the state local development runs in.
#
# Setup, in order:
#   1. Create + activate a store, then copy its ID from Settings » Stores.
#   2. Create 3 products (Basic / Pro / Premium), each with a Monthly and a
#      Yearly variant. Tax category = "Software as a Service" so VAT is charged
#      correctly. Copy the 6 variant IDs (product dropdown » Copy ID).
#   3. Create an API key (Test mode first; a separate Live one at launch).
#   4. Register a webhook at  POST https://<api-host>/api/billing/webhook
#      with the secret below, subscribed to:
#        subscription_created, subscription_updated, subscription_cancelled,
#        subscription_resumed, subscription_expired, subscription_paused,
#        subscription_unpaused, subscription_payment_success,
#        subscription_payment_failed, subscription_payment_refunded,
#        order_refunded
#      Locally, tunnel it:  npx cloudflared tunnel --url http://localhost:5000
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
# Any random string, 6-40 chars — you choose it and enter the same value in the
# Lemon Squeezy dashboard. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LEMONSQUEEZY_WEBHOOK_SECRET=
# MUST be false in production. While true the server accepts test-mode
# purchases; a live server with this left on would unlock real accounts from $0
# test checkouts. NODE_ENV=production with this true and billing keys present is
# a boot failure, not a warning — see config/env.ts.
LEMONSQUEEZY_TEST_MODE=false
# The six variant IDs. An unrecognised variant grants NOTHING, by design.
LS_VARIANT_BASIC_MONTHLY=
LS_VARIANT_BASIC_YEARLY=
LS_VARIANT_PRO_MONTHLY=
LS_VARIANT_PRO_YEARLY=
LS_VARIANT_PREMIUM_MONTHLY=
LS_VARIANT_PREMIUM_YEARLY=
# Free trial length in days, or 0 for no trial.
#
# MUST match the trial configured on the Basic variants in the LemonSqueezy
# dashboard — the API does not report it at request time, so this is our
# declaration of it. Above zero with no trial actually configured would
# advertise a free day on the landing page and then charge for it immediately.
#
# The trial is only ever SOLD on Basic monthly. Basic yearly carries the same
# trial in the dashboard but checkout skips it, because a trial on yearly would
# attempt roughly twelve times the charge on day two. Repeat trials are refused
# the same way — see controller/billing.controller.ts#checkout.
TRIAL_DAYS=0
# Browser origin (NOT the API host) — where a finished checkout returns to.
APP_URL=http://localhost:5173
