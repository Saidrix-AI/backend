# Server
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/saidrix-tutor

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# LLM provider: anthropic | openai | google
LLM_PROVIDER=google
# Optional: override the default model for the chosen provider
# LLM_MODEL=claude-sonnet-5

# Provider API keys (only the one matching LLM_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
