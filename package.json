{
  "name": "saidrix-tutor-backend",
  "version": "1.0.0",
  "description": "Saidrix AI Tutor backend - Express + LangGraph multi-agent server",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ingest:knowledge": "tsx scripts/ingest-knowledge.ts",
    "svg:audit": "tsx scripts/svg-audit.ts",
    "svg:metrics": "tsx scripts/gen-font-metrics.ts",
    "mermaid:fixture": "node scripts/dump-mermaid-fixture.mjs",
    "svg:e2e": "tsx scripts/svg-e2e.ts",
    "icons:backfill": "tsx scripts/backfill-icons.ts",
    "migrate:active-paths": "node dist/scripts/migrate-active-paths.js",
    "migrate:drop-banglish": "node scripts/migrate-drop-banglish.mjs",
    "migrate:ever-paid": "node scripts/backfill-ever-paid.mjs"
  },
  "dependencies": {
    "@langchain/anthropic": "^0.3.21",
    "@langchain/core": "^0.3.57",
    "@langchain/google-genai": "^0.2.10",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^0.5.11",
    "@pinecone-database/pinecone": "^8.1.0",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "fast-xml-parser": "^5.10.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "livekit-server-sdk": "^2.17.0",
    "mermaid": "^11.16.0",
    "mongoose": "^8.15.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "openai": "^5.23.2",
    "pino": "^9.7.0",
    "pino-http": "^10.4.0",
    "playwright-core": "^1.61.1",
    "ws": "^8.21.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
